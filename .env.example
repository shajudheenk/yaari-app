# Copy to .env and fill in. .env is gitignored.
#
# The publishable key is safe to ship inside client apps: every table is
# protected by row level security, so the key alone grants nothing.
# The service_role key is NOT in this file and must never reach a client
# or this repo — it bypasses RLS entirely. Keep it in Supabase and inject
# it only as an edge function secret.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Vite needs the VITE_ prefix to expose these to the admin console
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
